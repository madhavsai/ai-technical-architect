# Which provider to use when the frontend doesn't say — gemini or ollama.
LLM_PROVIDER=gemini

# Gemini (free tier) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Local Ollama (RTX 4090) — run `ollama serve`. Default here is the
# 16k-context qwen3-coder variant actually installed on this machine
# (`ollama list` to check yours — plain "qwen3-coder:30b" isn't pulled as-is).
OLLAMA_MODEL=qwen3-coder-16k:latest
# Override only if Ollama isn't on the default local port.
OLLAMA_LOCAL_HOST=http://127.0.0.1:11434
